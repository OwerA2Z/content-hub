{
  "name": "content-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "admin:recovery-code": "tsx src/server/reset-password.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "antd": "^6.6.2",
    "drizzle-orm": "latest",
    "express": "^5.3.0",
    "lucide-react": "^1.34.0",
    "multer": "^2.5.0",
    "parse5": "^8.1.1",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/multer": "^2.2.0",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  }
}
